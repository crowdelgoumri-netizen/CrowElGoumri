# ════════════════════════════════════════════════════════════════
# CrowdShipping — environment variables
# Copy to .env and fill in. Never commit .env.
# ════════════════════════════════════════════════════════════════

# ── Database ────────────────────────────────────────────────────
# Neon (recommended, free tier, hosted Postgres + PostGIS):
#   1. Sign up at https://neon.tech
#   2. Create a project, copy the connection string
#   3. Paste below
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require&schema=public"

# ── API ─────────────────────────────────────────────────────────
API_PORT=4000
API_HOST="0.0.0.0"
NODE_ENV="development"
JWT_SECRET="change-me-to-a-32-byte-random-string"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# ── Stripe (escrow via Stripe Connect) ──────────────────────────
# Get test keys at https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"
STRIPE_PLATFORM_FEE_BPS="1000"   # 10.00% in basis points

# ── S3 / object storage (photos, KYC docs) ──────────────────────
# Wasabi is ~80% cheaper than S3. Use S3-compatible API.
S3_ENDPOINT="https://s3.wasabisys.com"
S3_REGION="us-east-1"
S3_BUCKET="crowdshipping-dev"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ── Twilio (phone verification) ─────────────────────────────────
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_VERIFY_SERVICE_SID=""

# ── Mapbox (geocoding, maps) ────────────────────────────────────
MAPBOX_TOKEN=""

# ── Notifications (Phase 7) ─────────────────────────────────────
# Expo push notifications. Dev/test works without a token; production
# (standalone app) requires one. See https://expo.dev/accounts/[me]/credentials
EXPO_ACCESS_TOKEN=""

# Outbound SMS (Twilio). Presence of SMS_FROM_NUMBER + TWILIO_AUTH_TOKEN
# enables real SMS; otherwise the SMS channel is a logged stub.
SMS_FROM_NUMBER="+15551234567"

# Email (AWS SES). Presence of SES_FROM_ADDRESS enables real email;
# otherwise the email channel is a logged stub.
SES_FROM_ADDRESS="no-reply@crowdshipping.example"

# ── Feature flags ───────────────────────────────────────────────
# When false, KYC submissions go to manual admin review queue
KYC_PROVIDER="manual"            # "sumsub" | "manual"
SUMSUB_APP_TOKEN=""
SUMSUB_SECRET_KEY=""
