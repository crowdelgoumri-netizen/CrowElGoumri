{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "crowdshipping-mobile-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@crowdshipping/mobile", "exec", "expo", "start", "--web"],
      "port": 8081,
      "autoPort": true
    },
    {
      "name": "crowdshipping-api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@crowdshipping/api", "dev"],
      "port": 4000
    },
    {
      "name": "crowdshipping-admin",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@crowdshipping/admin", "dev"],
      "port": 3000,
      "autoPort": true
    }
  ]
}
