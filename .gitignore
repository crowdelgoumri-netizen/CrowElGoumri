# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
.next/
.expo/
*.tsbuildinfo

# Environment
.env
.env.local
.env.*.local
.env.test
!.env.example

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini
*.stackdump

# Local agent session plans
.zcode/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Database
*.db
*.db-journal

# Secrets / keys (never commit)
*.pem
*.key
secrets/

# Generated artifacts (keep source markdown + final PDF, ignore intermediates)
preview_*.png

# Testing
coverage/
.nyc_output/

# Deployment
.vercel/
.fly/

# Subagent-driven-development scratch workspace (ledgers, briefs, review packages)
.superpowers/

# Git worktrees created outside .claude/worktrees/ (e.g. when a nested dot-directory
# would break Jest's Windows testMatch glob resolution — see the DiasporaCart Phase 1
# SDD ledger for the repro).
/worktrees/

# Native prebuild output (regenerate with expo prebuild) + built binaries
apps/*/android/
apps/*/ios/
*.apk
*.aab
*.ipa
